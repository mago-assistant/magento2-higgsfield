{
    "name": "mago-assistant/magento2-higgsfield",
    "description": "Mago add-on: generate product images and videos with Higgsfield from the Magento admin chat",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "mago",
        "mago-addon",
        "higgsfield",
        "ai-images",
        "ai-video"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mago-assistant/magento2-higgsfield/issues",
        "source": "https://github.com/mago-assistant/magento2-higgsfield",
        "security": "https://github.com/mago-assistant/magento2-higgsfield/security/advisories/new"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "guzzlehttp/guzzle": "^7.0",
        "magento/framework": "^103.0.8",
        "magento/module-backend": "^102.0.8",
        "magento/module-catalog": "^104.0.8",
        "magento/module-config": "^101.2.8",
        "magento/module-store": "^101.1.8",
        "mago-assistant/magento2-mago": "^1.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MagoAssistant\\Higgsfield\\": ""
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "*",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "MagoAssistant\\Higgsfield\\Test\\": "Test/"
        }
    },
    "repositories": {
        "mage-os-mirror": {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        },
        "mage-os": {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/composer-root-update-plugin": true
        }
    }
}
